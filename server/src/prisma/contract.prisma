// use prisma-8


enum UserRole {
  USER
  HOST
  ADMIN
}

model User {
  id           String   @id @onCreate(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  profileImage String?
  bio          String?

  sessions     RefreshSession[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @onCreate(now()) @onUpdate(now())
}

model RefreshSession {
  id                  String   @id @onCreate(uuid())
  tokenHash           String   @unique

  familyId            String?
  replacedByTokenHash String?  @unique

  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt           DateTime
  revokedAt           DateTime?
  lastUsedAt          DateTime?

  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
}